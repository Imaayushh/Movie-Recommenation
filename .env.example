# Filmphile catalog source:
#   itunes (default) — no API key, no VPN needed, uses Apple's Top Movies charts
#   tmdb  — set TMDB_API_KEY below AND use a network where api.themoviedb.org is reachable
FILMPHILE_SOURCE=itunes

# TMDB API key — get one for free at https://www.themoviedb.org/settings/api
# Only required when FILMPHILE_SOURCE=tmdb. Never commit the real key.
TMDB_API_KEY=your_tmdb_api_key_here

# Gmail SMTP for the account sign-up verification emails.
# 1. Create an App Password at https://myaccount.google.com/apppasswords
#    (requires 2-Step Verification on the Google account).
# 2. GMAIL_USER = the full Gmail address, GMAIL_APP_PASSWORD = the 16-char app password.
# Until both are set the server runs in "development mode": the OTP is logged
# to the console and returned as devOtp in the API response instead of emailed.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password