{
  "name": "filmphile-movie-recommendation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "esbuild scripts/verify.ts --bundle --platform=node --format=cjs --outfile=.verify.cjs --log-level=error && node .verify.cjs",
    "verify": "npm run test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.5.4",
    "@astryxdesign/core": "^0.5.4",
    "@astryxdesign/theme-neutral": "^0.5.4",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
